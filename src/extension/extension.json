{
  "schemaVersion": 1,
  "apiVersion": 6,
  "compatibility": {
    "minIdeVersion": "0.1.0",
    "capabilities": [
      "editor.file-commands",
      "ui.webviews",
      "ui.settings",
      "editor.readonly-file-commands",
      "ui.source-navigation",
      "ui.clipboard-write",
      "compiler.php-optimization",
      "compiler.php-bytecode-inspection"
    ]
  },
  "entryPoint": "devline.bytecode.BytecodeExtension",
  "libraries": [
    "lib/devline-bytecode-viewer-0.1.3.jar",
    "lib/asm-9.8.jar",
    "lib/asm-util-9.8.jar",
    "lib/asm-tree-9.8.jar",
    "lib/asm-analysis-9.8.jar"
  ],
  "extension": {
    "schemaVersion": 1,
    "id": "devline.bytecode",
    "version": "0.1.3",
    "name": {
      "en": "Bytecode Viewer",
      "ru": "Просмотр байткода"
    },
    "description": {
      "en": "Inspect JVM bytecode from PHP, PHB, class, JAR, Kotlin and Java files.",
      "ru": "Просмотр JVM-байткода из PHP, PHB, class, JAR, Kotlin и Java."
    },
    "publisher": "DevLine",
    "icon": "data:image/png;base64,",
    "rpcNamespace": "bytecode",
    "enabledByDefault": true,
    "commands": [
      {
        "id": "inspect",
        "title": {
          "en": "Inspect bytecode",
          "ru": "Посмотреть байткод"
        },
        "readonly": true,
        "saveBeforeRun": false,
        "fileExtensions": [
          "php",
          "phb",
          "class",
          "jar",
          "kt",
          "java"
        ]
      }
    ],
    "tools": []
  },
  "commandViews": {
    "inspect": "viewer"
  },
  "webviews": [
    {
      "id": "viewer",
      "title": {
        "en": "Bytecode Viewer",
        "ru": "Просмотр байткода"
      },
      "html": "web/bytecode.html",
      "location": "dock",
      "icon": "code",
      "methods": [
        "state",
        "inspect",
        "job",
        "cancel",
        "classes",
        "classInfo",
        "method",
        "settings",
        "openSource",
        "notice",
        "copyText"
      ]
    },
    {
      "id": "settings",
      "title": {
        "en": "Bytecode Viewer",
        "ru": "Просмотр байткода"
      },
      "html": "web/bytecode.html",
      "location": "settings",
      "icon": "code",
      "methods": [
        "settings",
        "configure",
        "reset",
        "notice",
        "copyText"
      ]
    }
  ]
}
